# Copy to .env.local for local dev; set the same keys in Vercel → Settings → Environment Variables.
# Every key is optional for `npm run dev` — features degrade gracefully when unset.

# Canonical production origin, no trailing slash. Drives canonical URLs, sitemap, OG tags, Stripe redirects.
NEXT_PUBLIC_SITE_URL=https://example.com

# Cal.com booking link ("username/event-slug"). Unset → lessons page shows a "Request a lesson" CTA instead.
NEXT_PUBLIC_CAL_LINK=

# Resend — contact form notifications and store download emails.
RESEND_API_KEY=
# Where contact-form messages are delivered.
CONTACT_FORM_TO_EMAIL=
# Sender on a domain verified in Resend. Unset → onboarding@resend.dev (delivers ONLY to the Resend account owner),
# and the contact-form auto-reply to visitors stays off.
RESEND_FROM_EMAIL=

# Stripe — store checkout and the checkout.session.completed webhook (/api/webhooks/stripe).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel BotID (contact + checkout bot protection) needs no keys: it turns on when NEXT_PUBLIC_VERCEL_ENV is set,
# which Vercel does automatically (Settings → Environment Variables → "Automatically expose System Environment
# Variables" must stay on). Skipped in local dev and on other hosts. Optional: enable Deep Analysis in Vercel → Firewall.

# Vercel Blob — private storage for store downloads (read implicitly by @vercel/blob).
BLOB_READ_WRITE_TOKEN=
